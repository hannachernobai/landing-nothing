//- Міксини й дані підключаються в макеті, тому доступні в усіх блоках сторінки
include ../mixins/index
include ../data/index

doctype html
html(lang='en')
  head
    block meta
      meta(charset='utf-8')
      meta(name='viewport', content='width=device-width, initial-scale=1')
    block title
      title Keepsake
    block fonts
      include ../includes/fonts
    block styles
      link(rel='stylesheet', href='/src/styles/main.scss')
  body#top
    include ../includes/sprite.svg
    a.skip-link(href='#main') Skip to content
    block header
    main#main
      block content
    block footer
    a.to-top(href='#top', aria-label='Back to top')
      +icon('up')
    block scripts
